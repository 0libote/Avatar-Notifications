{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotifBuddy",
  "version": "0.1.0",
  "identifier": "com.notifbuddy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NotifBuddy",
        "url": "index.html",
        "width": 920,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      },
      {
        "label": "avatar",
        "title": "NotifBuddy Pal",
        "url": "avatar.html",
        "width": 210,
        "height": 270,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "A pixel pal that watches your notifications",
    "longDescription": "NotifBuddy sits on your screen and nudges you about unread notifications from the apps you choose."
  }
}
